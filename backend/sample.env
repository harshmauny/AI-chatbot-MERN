# Application Environment
NODE_ENV=development

# Server Configuration
PORT=5000

# Database
MONGODB_URL=mongodb://localhost:27017/ai-chatbot

# JWT Configuration (must be at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-please-change-this
JWT_EXPIRE_TIME=7d

# Cookie Configuration (must be at least 32 characters)
COOKIE_SECRET=your-super-secret-cookie-key-min-32-chars-long-please-change

# AI APIs
COHERE_API_KEY=your-cohere-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# CORS Configuration (comma-separated URLs for multiple origins)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100